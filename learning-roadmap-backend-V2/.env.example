# Copy this file to ".env" (which is gitignored) and fill in real values.
DB_PASSWORD=change-me
# At least 32 characters. Generate: openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-string-of-32-plus-chars

# Optional overrides
# DB_USERNAME=root
# DB_URL=jdbc:mysql://localhost:3306/learning_roadmap?createDatabaseIfNotExist=true&useSSL=false&serverTimezone=UTC
# JWT_EXPIRATION_MS=86400000
# CORS_ALLOWED_ORIGINS=http://localhost:3000
